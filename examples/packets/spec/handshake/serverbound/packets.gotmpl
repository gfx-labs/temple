package handshake_serverbound

import (
	"gfx.cafe/etherlands/go/common/protocol/packet"
	"gfx.cafe/etherlands/go/common/protocol/types"
	"gfx.cafe/etherlands/go/common/protocol/registry"
	"io"
)

var _ io.Reader

type Angle = registry.Angle
	type BitSet = registry.BitSet
	type Chat = registry.Chat
	type ChunkSection = registry.ChunkSection
	type CommandNode = registry.CommandNode
	type CommandParserDouble = registry.CommandParserDouble
	type CommandParserFloat = registry.CommandParserFloat
	type CommandParserInteger = registry.CommandParserInteger
	type CommandParserLong = registry.CommandParserLong
	type Identifier = registry.Identifier
	type NBT = types.NBT
	type PalettedContainer = registry.PalettedContainer
	type Position = registry.Position
	type RegistryTag = registry.RegistryTag
	type RegistryTags = registry.RegistryTags
	type Slot = registry.Slot
	type TabCompleteMatch = registry.TabCompleteMatch
	type UUID = types.UUID
	type VarInt = types.VarInt
	type VarLong = types.VarLong
	

type HandshakeServerbound struct {}

func (T HandshakeServerbound) PacketById(id VarInt) packet.Packet {
	switch id {
	case 0:
			return new(Handshake)
	}
	return nil
}

var Namespace registry.Namespace = HandshakeServerbound{}

type Handshake struct {
			ProtocolVersion VarInt
			ServerAddr string
			ServerPort uint16
			NextState VarInt
			}

	func (T *Handshake) Marshal(writer io.Writer) (err error) {
		err = types.MarshalVarInt(writer, VarInt((*T).ProtocolVersion))
		if err != nil {
			return
		}
	err = types.MarshalString(writer, string((*T).ServerAddr))
		if err != nil {
			return
		}
	err = types.MarshalUint16(writer, uint16((*T).ServerPort))
		if err != nil {
			return
		}
	err = types.MarshalVarInt(writer, VarInt((*T).NextState))
		if err != nil {
			return
		}
	return
	}

	func (T *Handshake) Unmarshal(reader io.Reader) (err error) {
		{
				var temp VarInt
				temp, err = types.UnmarshalVarInt(reader)
				(*T).ProtocolVersion = (temp)
			}
		if err != nil {
			return
		}
	{
				var temp string
				temp, err = types.UnmarshalString(reader)
				(*T).ServerAddr = (temp)
			}
		if err != nil {
			return
		}
	{
				var temp uint16
				temp, err = types.UnmarshalUint16(reader)
				(*T).ServerPort = (temp)
			}
		if err != nil {
			return
		}
	{
				var temp VarInt
				temp, err = types.UnmarshalVarInt(reader)
				(*T).NextState = (temp)
			}
		if err != nil {
			return
		}
	return
	}


	func (T *Handshake) PacketId() VarInt {
		return VarInt(0)
	}

	func (T *Handshake) Namespace() registry.Namespace {
		return Namespace
	}

	func (T *Handshake) PacketName() string {
		return "Handshake"
	}
