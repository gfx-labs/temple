		}
	}
	return
	}

	func (T *TabCompleteMatch) Unmarshal(reader io.Reader) (err error) {
		{
				var temp string
				temp, err = types.UnmarshalString(reader)
				(*T).Match = (temp)
			}
		if err != nil {
			return
		}
	{
			var exists bool
			exists, err = types.UnmarshalBool(reader)
			if err != nil {
				return
			}
			if exists {
				(*T).Tooltip.inner = new(Chat)
				err = (*(*T).Tooltip.inner).Unmarshal(reader)
		if err != nil {
			return
		}
	}
		}
