	}
		}
	return
	}

	type TabCompleteMatch struct {
			Match string
			Tooltip struct {
			inner *Chat
		}
			}

	func (T *TabCompleteMatch) Marshal(writer io.Writer) (err error) {
		err = types.MarshalString(writer, string((*T).Match))
		if err != nil {
			return
		}
	if (*T).Tooltip.inner == nil {
			err = types.MarshalBool(writer, false)
			if err != nil {
				return
			}
		} else {
			err = types.MarshalBool(writer, true)
