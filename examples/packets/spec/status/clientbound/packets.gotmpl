package status_clientbound

import (
	"gfx.cafe/etherlands/go/common/protocol/packet"
	"gfx.cafe/etherlands/go/common/protocol/types"
	"gfx.cafe/etherlands/go/common/protocol/registry"
	"io"
)

var _ io.Reader

type Angle = registry.Angle
	type BitSet = registry.BitSet
	type Chat = registry.Chat
	type ChunkSection = registry.ChunkSection
	type CommandNode = registry.CommandNode
	type CommandParserDouble = registry.CommandParserDouble
	type CommandParserFloat = registry.CommandParserFloat
	type CommandParserInteger = registry.CommandParserInteger
	type CommandParserLong = registry.CommandParserLong
	type Identifier = registry.Identifier
	type NBT = types.NBT
	type PalettedContainer = registry.PalettedContainer
	type Position = registry.Position
	type RegistryTag = registry.RegistryTag
	type RegistryTags = registry.RegistryTags
	type Slot = registry.Slot
	type TabCompleteMatch = registry.TabCompleteMatch
	type UUID = types.UUID
	type VarInt = types.VarInt
	type VarLong = types.VarLong
	

type StatusClientbound struct {}

func (T StatusClientbound) PacketById(id VarInt) packet.Packet {
	switch id {
	case 1:
			return new(Pong)
	case 0:
			return new(Response)
	}
	return nil
}

var Namespace registry.Namespace = StatusClientbound{}

type Pong struct {
			Payload int64
			}

	func (T *Pong) Marshal(writer io.Writer) (err error) {
		err = types.MarshalInt64(writer, int64((*T).Payload))
		if err != nil {
			return
		}
	return
	}

	func (T *Pong) Unmarshal(reader io.Reader) (err error) {
		{
				var temp int64
				temp, err = types.UnmarshalInt64(reader)
				(*T).Payload = (temp)
			}
		if err != nil {
			return
		}
	return
	}


	func (T *Pong) PacketId() VarInt {
		return VarInt(1)
	}

	func (T *Pong) Namespace() registry.Namespace {
		return Namespace
	}

	func (T *Pong) PacketName() string {
		return "Pong"
	}
type Response struct {
			JsonResponse string
			}

	func (T *Response) Marshal(writer io.Writer) (err error) {
		err = types.MarshalString(writer, string((*T).JsonResponse))
		if err != nil {
			return
		}
	return
	}

	func (T *Response) Unmarshal(reader io.Reader) (err error) {
		{
				var temp string
				temp, err = types.UnmarshalString(reader)
				(*T).JsonResponse = (temp)
			}
		if err != nil {
			return
		}
	return
	}


	func (T *Response) PacketId() VarInt {
		return VarInt(0)
	}

	func (T *Response) Namespace() registry.Namespace {
		return Namespace
	}

	func (T *Response) PacketName() string {
		return "Response"
	}
