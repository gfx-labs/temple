package status_serverbound

import (
	"gfx.cafe/etherlands/go/common/protocol/packet"
	"gfx.cafe/etherlands/go/common/protocol/types"
	"gfx.cafe/etherlands/go/common/protocol/registry"
	"io"
)

var _ io.Reader

type Angle = registry.Angle
	type BitSet = registry.BitSet
	type Chat = registry.Chat
	type ChunkSection = registry.ChunkSection
	type CommandNode = registry.CommandNode
	type CommandParserDouble = registry.CommandParserDouble
	type CommandParserFloat = registry.CommandParserFloat
	type CommandParserInteger = registry.CommandParserInteger
	type CommandParserLong = registry.CommandParserLong
	type Identifier = registry.Identifier
	type NBT = types.NBT
	type PalettedContainer = registry.PalettedContainer
	type Position = registry.Position
	type RegistryTag = registry.RegistryTag
	type RegistryTags = registry.RegistryTags
	type Slot = registry.Slot
	type TabCompleteMatch = registry.TabCompleteMatch
	type UUID = types.UUID
	type VarInt = types.VarInt
	type VarLong = types.VarLong
	

type StatusServerbound struct {}

func (T StatusServerbound) PacketById(id VarInt) packet.Packet {
	switch id {
	case 1:
			return new(Ping)
	case 0:
			return new(Request)
	}
	return nil
}

var Namespace registry.Namespace = StatusServerbound{}

type Ping struct {
			Payload int64
			}

	func (T *Ping) Marshal(writer io.Writer) (err error) {
		err = types.MarshalInt64(writer, int64((*T).Payload))
		if err != nil {
			return
		}
	return
	}

	func (T *Ping) Unmarshal(reader io.Reader) (err error) {
		{
				var temp int64
				temp, err = types.UnmarshalInt64(reader)
				(*T).Payload = (temp)
			}
		if err != nil {
			return
		}
	return
	}


	func (T *Ping) PacketId() VarInt {
		return VarInt(1)
	}

	func (T *Ping) Namespace() registry.Namespace {
		return Namespace
	}

	func (T *Ping) PacketName() string {
		return "Ping"
	}
type Request struct{}

	func (T *Request) Marshal(writer io.Writer) (err error) {
		return
	}

	func (T *Request) Unmarshal(reader io.Reader) (err error) {
		return
	}


	func (T *Request) PacketId() VarInt {
		return VarInt(0)
	}

	func (T *Request) Namespace() registry.Namespace {
		return Namespace
	}

	func (T *Request) PacketName() string {
		return "Request"
	}
